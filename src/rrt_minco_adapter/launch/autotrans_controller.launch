<launch>
  <!-- RRT直接使用AutoTrans现有PositionCommand参考接口，不启动FUEL/Diff轨迹桥。 -->
  <include file="$(find payload_mpc_controller)/launch/quad_wind_mpc_controller.launch">
    <arg name="enable_logger" value="false"/>
    <arg name="enable_rosbag" value="false"/>
    <arg name="trajectory_topic" value="/UAV0/rrt/unused_autotrans_trajectory"/>
    <arg name="position_cmd_topic" value="/UAV0/planning/pos_cmd"/>
    <arg name="setpoint_topic" value="/UAV0/mavros/setpoint_raw/attitude"/>
    <arg name="recovery_position_setpoint_topic" value="/UAV0/mavros/setpoint_raw/local"/>
  </include>
  <!-- 仅本入口覆盖，不修改MPC通用配置。起飞保持实际XY，CH8高位才跟踪轨迹。 -->
  <param name="/mpc_controller_node/takeoff/target_z" value="0.5"/>
  <param name="/mpc_controller_node/fixed_hover/enabled" value="false"/>
  <param name="/mpc_controller_node/rc_mode/mode_channel" value="7"/>
  <param name="/mpc_controller_node/rc_mode/takeoff_hover_channel" value="7"/>
  <param name="/mpc_controller_node/rc_mode/land_channel" value="9"/>
  <param name="/mpc_controller_node/rc_mode/low_threshold" value="1300"/>
  <param name="/mpc_controller_node/rc_mode/high_threshold" value="1800"/>
</launch>
