<?xml version="1.0" ?>
<launch>
  <!-- 现场配置：以下默认值仅供启动查看界面，飞行前按 FAST-LIO 实测坐标修改。
       当前降落 XY 与 route.yaml 示例末点一致，右侧 ArUco 的实际位置需另行填写。 -->
  <arg name="ground_z" default="0.0"/>
  <arg name="bridge_yaw" default="0.0"/>
  <arg name="landing_x" default="11.3"/>
  <arg name="landing_y" default="0.0"/>
  <arg name="bridge_floor_height" default="1.5"/>
  <arg name="bridge_clear_height" default="1.2"/>
  <arg name="floor_margin" default="0.15"/>
  <arg name="ceiling_margin" default="0.15"/>
  <arg name="cruise_height_above_floor" default="0.3"/>
  <arg name="landing_platform_delta_z" default="0.0"/>
  <arg name="route_file" default="$(find uav1_bridge_inspection)/config/route.yaml"/>
  <arg name="enable_view" default="true"/>
  <arg name="enable_detection" default="true"/>
  <arg name="enable_thermal" default="true"/>
  <!-- 外力估计：aerothrow_ndob 为 NDOB，window_opt 保留原滑动窗口方法；重启生效。 -->
  <arg name="force_estimator_method" default="window_opt"/>
  <arg name="ndob_rate" default="20.0"/>
  <arg name="ndob_cutoff_freq" default="5.0"/>
  <arg name="floor_z" default="$(eval float(arg(&quot;ground_z&quot;)) + float(arg(&quot;bridge_floor_height&quot;)))"/>
  <arg name="ceiling_z" default="$(eval float(arg(&quot;floor_z&quot;)) + float(arg(&quot;bridge_clear_height&quot;)))"/>
  <arg name="takeoff_z" default="$(eval float(arg(&quot;floor_z&quot;)) + float(arg(&quot;cruise_height_above_floor&quot;)))"/>
  <arg name="landing_approach_z" default="$(arg takeoff_z)"/>
  <include file="$(find uav1_bridge_inspection)/launch/planner.launch">
    <arg name="ground_z" value="$(arg ground_z)"/>
    <arg name="floor_z" value="$(arg floor_z)"/>
    <arg name="ceiling_z" value="$(arg ceiling_z)"/>
    <arg name="floor_margin" value="$(arg floor_margin)"/>
    <arg name="ceiling_margin" value="$(arg ceiling_margin)"/>
  </include>
  <include file="$(find uav1_bridge_inspection)/launch/control.launch">
    <arg name="takeoff_z" value="$(arg takeoff_z)"/>
    <arg name="force_estimator_method" value="$(arg force_estimator_method)"/>
    <arg name="ndob_rate" value="$(arg ndob_rate)"/>
    <arg name="ndob_cutoff_freq" value="$(arg ndob_cutoff_freq)"/>
  </include>
  <include file="$(find uav1_bridge_inspection)/launch/detection.launch" if="$(arg enable_detection)">
    <arg name="enable_thermal" value="$(arg enable_thermal)"/>
  </include>
  <node pkg="uav1_bridge_inspection" type="bridge_mission.py" name="bridge_mission" output="screen">
    <rosparam command="load" file="$(arg route_file)"/>
    <param name="bridge_yaw" value="$(arg bridge_yaw)"/>
    <param name="landing_x" value="$(arg landing_x)"/>
    <param name="landing_y" value="$(arg landing_y)"/>
    <param name="landing_approach_z" value="$(arg landing_approach_z)"/>
    <param name="landing_platform_delta_z" value="$(arg landing_platform_delta_z)"/>
    <remap from="odom" to="/UAV1/fast_lio/Odom_high_freq"/>
    <remap from="state" to="/UAV1/mavros/state"/>
    <remap from="start" to="/traj_start_trigger"/>
    <remap from="goal" to="/UAV1/planning/goal"/>
    <remap from="turn_goal" to="/UAV1/bridge/waypoint_turn"/>
    <remap from="need_to_land" to="/UAV1/need_to_land"/>
    <remap from="platform_reference" to="/UAV1/bridge/platform_reference"/>
    <remap from="status" to="/UAV1/bridge/status"/>
    <remap from="route" to="/UAV1/bridge/route"/>
  </node>
  <!-- 沿用多机的机体模型显示，仅订阅定位和规划指令。 -->
  <node if="$(arg enable_view)" pkg="odom_visualization" type="odom_visualization"
        name="bridge_odom_visualization" output="screen">
    <remap from="~odom" to="/UAV1/fast_lio/Odom_high_freq"/>
    <remap from="~cmd" to="/UAV1/planning/pos_cmd"/>
    <param name="color/a" value="1.0"/>
    <param name="color/r" value="0.0"/>
    <param name="color/g" value="0.35"/>
    <param name="color/b" value="1.0"/>
    <param name="covariance_scale" value="100.0"/>
    <param name="robot_scale" value="0.35"/>
    <param name="frame_id" value="UAV1/camera_init"/>
    <param name="use_cmd_yaw_for_mesh" value="true"/>
    <param name="cmd_yaw_timeout" value="0.8"/>
    <param name="rotate_yaw_deg" value="90.0"/>
    <param name="tf45" value="false"/>
    <param name="drone_id" value="1"/>
  </node>
  <node if="$(arg enable_view)" pkg="uav1_inplace_landing_test" type="uav1_xyz_overlay.py"
        name="bridge_landing_xyz_overlay" output="screen">
    <param name="odometry_topic" value="/UAV1/fast_lio/Odom_high_freq"/>
    <param name="image_topic" value="/UAV1/landing/debug_image"/>
    <param name="output_topic" value="/UAV1/bridge/landing/xyz_image"/>
  </node>
  <node if="$(arg enable_view)" pkg="uav1_bridge_inspection" type="landing_marker.py"
        name="bridge_landing_marker" output="screen">
    <param name="landing_config_ns" value="/UAV1/precision_landing_node"/>
    <remap from="target_pose" to="/UAV1/landing/target_pose"/>
    <remap from="odometry" to="/UAV1/fast_lio/Odom_high_freq"/>
    <remap from="marker" to="/UAV1/bridge/landing_marker"/>
  </node>
  <node if="$(arg enable_view)" pkg="uav1_bridge_inspection" type="bridge_view.py" name="bridge_view" output="screen">
    <param name="rviz_config" value="$(find uav1_bridge_inspection)/config/bridge.rviz"/>
  </node>
</launch>
