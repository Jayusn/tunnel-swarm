<?xml version="1.0" ?>
<launch>
  <arg name="ground_z"/>
  <arg name="floor_z"/>
  <arg name="ceiling_z"/>
  <arg name="floor_margin" default="0.15"/>
  <arg name="ceiling_margin" default="0.15"/>
  <include file="$(find diff_planner)/launch/include/advanced_param_exp.xml">
    <arg name="local_map_size_x" value="7.5"/>
    <arg name="local_map_size_y" value="4.5"/>
    <arg name="local_map_size_z" value="3.0"/>
    <arg name="odom_topic" value="/UAV1/fast_lio/Odom_high_freq"/>
    <arg name="cloud_topic" value="/UAV1/fast_lio/cloud_registered"/>
    <arg name="camera_pose_topic" value="unused_camera_pose"/>
    <arg name="depth_topic" value="unused_depth"/>
    <arg name="cx" value="319.3"/>
    <arg name="cy" value="239.1"/>
    <arg name="fx" value="386.2"/>
    <arg name="fy" value="386.2"/>
    <arg name="max_vel" value=".2"/>
    <arg name="max_acc" value=".2"/>
    <arg name="max_jer" value="20.0"/>
    <arg name="planning_horizon" value="7.5"/>
    <arg name="enable_virtual_wall" value="true"/>
    <!-- 只收缩规划边界；实际底板坐标和相对底板的航点高度不变。 -->
    <arg name="virtual_ground" value="$(eval float(arg('floor_z')) + float(arg('floor_margin')))"/>
    <arg name="virtual_ceil" value="$(eval float(arg('ceiling_z')) - float(arg('ceiling_margin')))"/>
    <arg name="map_resolution" value=".05"/>
    <arg name="inflation_size" value=".099"/>
    <arg name="flight_type" value="1"/>
    <arg name="point_num" value="0"/>
    <arg name="drone_id" value="1"/>
    <arg name="init_x" value="0.0"/>
    <arg name="init_y" value="0.0"/>
    <arg name="init_z" value="0.0"/>
    <arg name="cloud_use_init_offset" value="false"/>
    <arg name="planning_frame" value="UAV1/camera_init"/>
    <arg name="manual_goal_topic" value="/UAV1/planning/goal"/>
    <arg name="require_pre_agent_trajectory" value="false"/>
    <arg name="enable_fapp_dynamic_avoidance" value="false"/>
    <arg name="fading_time" value="-1.0"/>
    <arg name="mondify_final_goal" value="false"/>
    <arg name="point0_x" value="0.0"/>
    <arg name="point0_y" value="0.0"/>
    <arg name="point0_z" value="0.0"/>
    <arg name="point1_x" value="0.0"/>
    <arg name="point1_y" value="0.0"/>
    <arg name="point1_z" value="0.0"/>
    <arg name="point2_x" value="0.0"/>
    <arg name="point2_y" value="0.0"/>
    <arg name="point2_z" value="0.0"/>
    <arg name="point3_x" value="0.0"/>
    <arg name="point3_y" value="0.0"/>
    <arg name="point3_z" value="0.0"/>
    <arg name="point4_x" value="0.0"/>
    <arg name="point4_y" value="0.0"/>
    <arg name="point4_z" value="0.0"/>
  </include>
  <!-- 保留优化校验余量；发布前统一缩放多项式时间，规划器和 NMPC 共用同一执行轨迹。 -->
  <param name="/drone_1_diff_planner_node/manager/execution_max_velocity" value="0.2"/>
  <param name="/drone_1_diff_planner_node/manager/execution_max_acceleration" value="0.2"/>
  <!-- 贴近当前航点高度的软偏好；允许为避障上下绕行。 -->
  <param name="/drone_1_diff_planner_node/optimization/weight_waypoint_height" value="1000.0"/>
  <!-- 双侧均有障碍时优先走当前通路中间；仅本桥梁实例开启。 -->
  <param name="/drone_1_diff_planner_node/optimization/weight_corridor_center" value="10000.0"/>
  <param name="/drone_1_diff_planner_node/optimization/corridor_center_search_distance" value="0.8"/>
  <param name="/drone_1_diff_planner_node/grid_map/ground_height" value="$(arg ground_z)"/>
  <param name="/drone_1_diff_planner_node/grid_map/visualization_truncate_height" value="$(eval float(arg(&quot;ceiling_z&quot;)) + 1.0)"/>
  <node pkg="diff_planner" type="traj_server" name="drone_1_traj_server" output="screen">
    <remap from="/position_cmd" to="/UAV1/planning/pos_cmd"/>
    <remap from="~planning/trajectory" to="/drone_1_planning/trajectory"/>
    <remap from="/planning/yaw" to="/UAV1/bridge/traj_yaw"/>
    <remap from="~heartbeat" to="/drone_1_traj_server/heartbeat"/>
    <remap from="/planning/traj_started" to="/UAV1/planning/traj_started"/>
    <param name="traj_server/time_forward" value="1.0"/>
    <param name="traj_server/heartbeat_timeout" value="180.0"/>
  </node>
</launch>
