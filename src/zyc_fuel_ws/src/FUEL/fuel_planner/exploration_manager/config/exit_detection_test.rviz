Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Preferences:
  PromptSaveOnExit: false
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/Group
      Displays:
      - Alpha: 1
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 1.25
          Min Value: -0.699999988079071
          Value: false
        Axis: Z
        Channel Name: intensity
        Class: rviz/PointCloud2
        Color: 126; 126; 126
        Color Transformer: AxisColor
        Decay Time: 0
        Enabled: false
        Invert Rainbow: false
        Max Color: 0; 0; 0
        Min Color: 0; 0; 0
        Name: occupied_local
        Position Transformer: XYZ
        Queue Size: 10
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.10000000149011612
        Style: Boxes
        Topic: /exit_detection_test/map/occupancy_local
        Unreliable: false
        Use Fixed Frame: true
        Use rainbow: true
        Value: false
      - Alpha: 1
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 1.25
          Min Value: -2
          Value: false
        Axis: Z
        Channel Name: intensity
        Class: rviz/PointCloud2
        Color: 116; 116; 116
        Color Transformer: AxisColor
        Decay Time: 0
        Enabled: true
        Invert Rainbow: false
        Max Color: 0; 0; 0
        Min Color: 0; 0; 0
        Name: occupied_all
        Position Transformer: XYZ
        Queue Size: 10
        Selectable: true
        Size (Pixels): 15
        Size (m): 0.20000000298023224
        Style: Boxes
        Topic: /exit_detection_test/map/occupancy_all
        Unreliable: false
        Use Fixed Frame: true
        Use rainbow: true
        Value: true
      - Alpha: 0.30000001192092896
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 1.899999976158142
          Min Value: -0.699999988079071
          Value: false
        Axis: Z
        Channel Name: intensity
        Class: rviz/PointCloud2
        Color: 106; 106; 106
        Color Transformer: FlatColor
        Decay Time: 0
        Enabled: true
        Invert Rainbow: false
        Max Color: 0; 0; 0
        Min Color: 0; 0; 0
        Name: occupied_local_inflate
        Position Transformer: XYZ
        Queue Size: 10
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.10000000149011612
        Style: Boxes
        Topic: /exit_detection_test/map/occupancy_local_inflate
        Unreliable: false
        Use Fixed Frame: true
        Use rainbow: true
        Value: true
      - Alpha: 0.10000000149011612
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 1.899999976158142
          Min Value: -0.699999988079071
          Value: false
        Axis: Z
        Channel Name: intensity
        Class: rviz/PointCloud2
        Color: 104; 104; 104
        Color Transformer: FlatColor
        Decay Time: 0
        Enabled: false
        Invert Rainbow: false
        Max Color: 0; 0; 0
        Min Color: 0; 0; 0
        Name: unknown
        Position Transformer: XYZ
        Queue Size: 10
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.10000000149011612
        Style: Flat Squares
        Topic: /exit_detection_test/map/unknown
        Unreliable: false
        Use Fixed Frame: true
        Use rainbow: true
        Value: false
      - Alpha: 0.699999988079071
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 10
          Min Value: -10
          Value: true
        Axis: Z
        Channel Name: intensity
        Class: rviz/PointCloud2
        Color: 0; 0; 0
        Color Transformer: Intensity
        Decay Time: 0
        Enabled: false
        Invert Rainbow: false
        Max Color: 0; 0; 0
        Min Color: 0; 0; 0
        Name: local_esdf
        Position Transformer: XYZ
        Queue Size: 10
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.10000000149011612
        Style: Flat Squares
        Topic: /exit_detection_test/map/esdf
        Unreliable: false
        Use Fixed Frame: true
        Use rainbow: true
        Value: false
      - Class: rviz/Marker
        Enabled: false
        Marker Topic: /exit_detection_test/map/update_range
        Name: local_range
        Namespaces: {}
        Queue Size: 100
        Value: false
      - Alpha: 1
        Autocompute Intensity Bounds: true
        Autocompute Value Bounds:
          Max Value: 10
          Min Value: -10
          Value: true
        Axis: Z
        Channel Name: intensity
        Class: rviz/PointCloud2
        Color: 255; 255; 255
        Color Transformer: Intensity
        Decay Time: 0
        Enabled: false
        Invert Rainbow: false
        Max Color: 255; 255; 255
        Min Color: 0; 0; 0
        Name: depth_cloud
        Position Transformer: XYZ
        Queue Size: 10
        Selectable: true
        Size (Pixels): 3
        Size (m): 0.019999999552965164
        Style: Boxes
        Topic: /exit_detection_test/map/depth_cloud
        Unreliable: false
        Use Fixed Frame: true
        Use rainbow: true
        Value: false
      Enabled: true
      Name: LocalMap
    - Class: rviz/Marker
      Name: 出口候选与确认
      Enabled: true
      Marker Topic: /exit_detection_test/markers
      Queue Size: 100
      Namespaces: {}
      Value: true
  Enabled: true
  Global Options:
    Background Color: 255; 255; 255
    Default Light: true
    Fixed Frame: UAV0/camera_init
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0.6
      Pitch: 0.8
      Yaw: 0.8
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Width: 1200
  Height: 800
