<launch>
    <!-- 2026-07-28: 后机新增独立Diff接力规划器；接收前机释放的离散目标，使用UAV1自身里程计和点云避障。 -->
    <!-- CAV1 为单机工作区，Diff-Planner 与 AutoTrans 共用 FAST-LIO 的雷达状态。 -->
    <arg name="odom_topic" default="/UAV1/fast_lio/Odom_high_freq"/>
    <arg name="cloud_topic" default="/UAV1/fast_lio/cloud_registered"/>
    <arg name="goal_topic" default="/UAV1/planning/goal"/>
    <arg name="position_cmd_topic" default="/UAV1/planning/pos_cmd"/>
    <arg name="max_vel" default="0.50"/>
    <arg name="max_acc" default="0.50"/>
    <arg name="enable_rviz" default="true"/>
    <arg name="record_dynamic_debug" default="false"/>
    <arg name="dynamic_bag_prefix" default="/home/oem/bags/corridor_debug"/>
    <!-- UAV1 LDOP 动态检测只使用独立限频点云，不改变 Diff 原始建图输入。 -->
    <arg name="enable_ldop" default="true"/>
    <arg name="detector_backend" default="legacy"/>
    <arg name="fapp_verified_preset" default="false"/>
    <arg name="enable_fapp_dynamic_avoidance" default="false"/>
    <arg name="fapp_planner_priority" default="false"/>
    <arg name="start_ldop" default="$(eval arg('detector_backend') == 'ldop' or (arg('detector_backend') == 'legacy' and arg('enable_ldop')))"/>
    <arg name="ldop_input_rate" default="5.0"/>
    <!-- 垂地障碍物锁定一侧，避免重规划时在障碍物两侧来回换边。 -->
    <arg name="enable_vertical_obstacle_side_lock" default="true"/>
    <arg name="side_lock_corridor_half_width" default="0.75"/>
    <arg name="side_lock_width_similarity_tolerance" default="0.05"/>
    <!-- 关闭强制下穿分支，使用普通三维搜索选择上绕、侧绕或下绕。 -->
    <arg name="enable_suspended_obstacle_underpass" default="false"/>
    <arg name="underpass_corridor_half_width" default="0.25"/>
    <arg name="underpass_min_descent" default="0.20"/>
    <arg name="underpass_min_vertical_gap" default="0.25"/>
    <arg name="underpass_min_height" default="0.15"/>
    <arg name="underpass_search_timeout" default="0.15"/>
    <!-- 周期/普通重规划只有质量不劣于当前轨迹时才允许替换。 -->
    <arg name="enable_replan_quality_gate" default="true"/>
    <arg name="replan_max_clearance_drop" default="0.03"/>
    <arg name="replan_min_clearance_improvement" default="0.05"/>
    <arg name="replan_max_length_ratio" default="1.05"/>
    <arg name="replan_max_jerk_ratio" default="1.50"/>
    <arg name="replan_max_handoff_position_error" default="0.06"/>
    <arg name="replan_max_handoff_velocity_error" default="0.10"/>
    <!-- 接力入口已用标定参数发布该TF；独立调试时才允许本launch发布零偏移TF。 -->
    <arg name="publish_world_to_follower_tf" default="true"/>

    <!-- 2026-07-28: flight_type=1启用运行时外部目标；占位航点不会在该模式执行。 -->
    <include file="$(find diff_planner)/launch/include/advanced_param_exp.xml">
        <arg name="drone_id" value="1"/>
        <arg name="enable_fapp_dynamic_avoidance" value="$(arg enable_fapp_dynamic_avoidance)"/>
        <arg name="fapp_planner_priority" value="$(arg fapp_planner_priority)"/>
        <arg name="planner_heartbeat_topic" value="/drone_1_planning/heartbeat"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="camera_pose_topic" value="no_use_uav1_pose"/>
        <arg name="depth_topic" value="no_use_uav1_depth"/>
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>
        <arg name="enable_suspended_obstacle_underpass" value="$(arg enable_suspended_obstacle_underpass)"/>
        <arg name="underpass_corridor_half_width" value="$(arg underpass_corridor_half_width)"/>
        <arg name="underpass_min_descent" value="$(arg underpass_min_descent)"/>
        <arg name="underpass_min_vertical_gap" value="$(arg underpass_min_vertical_gap)"/>
        <arg name="underpass_min_height" value="$(arg underpass_min_height)"/>
        <arg name="underpass_search_timeout" value="$(arg underpass_search_timeout)"/>
        <arg name="enable_vertical_obstacle_side_lock" value="$(arg enable_vertical_obstacle_side_lock)"/>
        <arg name="side_lock_corridor_half_width" value="$(arg side_lock_corridor_half_width)"/>
        <arg name="side_lock_width_similarity_tolerance" value="$(arg side_lock_width_similarity_tolerance)"/>
        <arg name="enable_replan_quality_gate" value="$(arg enable_replan_quality_gate)"/>
        <arg name="replan_max_clearance_drop" value="$(arg replan_max_clearance_drop)"/>
        <arg name="replan_min_clearance_improvement" value="$(arg replan_min_clearance_improvement)"/>
        <arg name="replan_max_length_ratio" value="$(arg replan_max_length_ratio)"/>
        <arg name="replan_max_jerk_ratio" value="$(arg replan_max_jerk_ratio)"/>
        <arg name="replan_max_handoff_position_error" value="$(arg replan_max_handoff_position_error)"/>
        <arg name="replan_max_handoff_velocity_error" value="$(arg replan_max_handoff_velocity_error)"/>
        <arg name="cx" value="319.31427001953125"/>
        <arg name="cy" value="239.09725952148438"/>
        <arg name="fx" value="386.2706298828125"/>
        <arg name="fy" value="386.2706298828125"/>
        <!-- 后机速度、加速度规划上限均为0.5，沿用规划器原有的可行性检查容差。 -->
        <arg name="max_vel" value="$(arg max_vel)"/>
        <arg name="max_acc" value="$(arg max_acc)"/>
        <arg name="max_jer" value="8.0"/>
        <!-- 后机点云建图与优化共享单线程回调，给一次困难目标留出完整的规划窗口。 -->
        <arg name="planning_timeout" value="2.0"/>
        <arg name="planning_horizon" value="8.0"/>
        <arg name="waypoint_switch_dist" value="0.12"/>
        <!-- 2026-07-28: 20m局部窗口覆盖当前U形通道，UAV1点云独立形成静态避障地图。 -->
        <arg name="local_map_size_x" value="20.0"/>
        <arg name="local_map_size_y" value="20.0"/>
        <arg name="local_map_size_z" value="3.0"/>
        <arg name="enable_virtual_wall" value="true"/>
        <arg name="virtual_ceil" value="2.25"/>
        <arg name="virtual_ground" value="0.05"/>
        <arg name="map_resolution" value="0.05"/>
        <!-- 0.05m分辨率下向外膨胀2格，各轴实际膨胀约0.10m。 -->
        <arg name="inflation_size" value="0.099"/>
        <!-- 2026-07-28: UAV1门洞点云偶发假占据时用更强FREE射线及时清除，避免目标被改回当前位置。 -->
        <arg name="lidar_p_miss" value="0.35"/>
        <!-- 2026-07-28: 后机最新日志在第4个点出现start_occ=3并持续50s；3s衰减移动球/前机鬼影，
             360度雷达持续命中的真实墙体仍会保持占据。 -->
        <arg name="fading_time" value="3"/>
        <arg name="obstacle_clearance" value="0.18"/>
        <!-- 2026-07-28: FAST-LIO点云/里程计均为UAV1局部坐标，不叠加出生点偏移。 -->
        <arg name="init_x" value="0.0"/>
        <arg name="init_y" value="0.0"/>
        <arg name="init_z" value="0.0"/>
        <arg name="cloud_use_init_offset" value="false"/>
        <arg name="planning_frame" value="UAV1/camera_init"/>
        <arg name="enable_stuck_detect" value="true"/>
        <arg name="stuck_detect_grace_time" value="8.0"/>
        <!-- 2026-07-28: 不锁死全局窗口，允许雷达射线清除摆球移动后的旧占据；静态墙体仍会持续观测。 -->
        <arg name="preserve_global_map" value="false"/>
        <arg name="flight_type" value="1"/>
        <arg name="manual_goal_topic" value="$(arg goal_topic)"/>
        <!-- 2026-07-28: 前机是FUEL而非Diff，不会发送prev traj；后机收到接力点后直接用自身Diff规划。 -->
        <arg name="require_pre_agent_trajectory" value="false"/>
        <!-- 2026-07-28: 后机规划失败由safe_follower改发已验证短子目标，禁用会阻塞FSM并导致Lost heartbeat的随机初始化。 -->
        <arg name="enable_random_global_init" value="true"/>
        <!-- 自身位置被判占据时优先沿实飞历史后退约0.45m；历史不可用时允许垂直/侧向脱障。 -->
        <arg name="enable_occupied_recovery" value="true"/>
        <arg name="preserve_modified_goal_height" value="true"/>
        <arg name="mondify_final_goal" value="false"/>
        <arg name="escape_max_distance" value="0.45"/>
        <!-- 0 表示节点运行期间不按时间删除自身实飞历史，后退点只按累计 XY 距离选择。 -->
        <arg name="escape_history_time" value="0.0"/>
        <arg name="escape_speed" value="0.10"/>
        <arg name="escape_recovery_height" value="0.60"/>
        <!-- 用户规则：未经用户明确确认，永远不得把 history_only_occupied_recovery 重新设为 true。 -->
        <arg name="history_only_occupied_recovery" value="false"/>
        <arg name="wait_new_target_after_occupied_recovery" value="true"/>
        <arg name="point_num" value="1"/>
        <arg name="point0_x" value="0.0"/><arg name="point0_y" value="0.0"/><arg name="point0_z" value="0.60"/>
        <arg name="point1_x" value="0.0"/><arg name="point1_y" value="0.0"/><arg name="point1_z" value="0.60"/>
        <arg name="point2_x" value="0.0"/><arg name="point2_y" value="0.0"/><arg name="point2_z" value="0.60"/>
        <arg name="point3_x" value="0.0"/><arg name="point3_y" value="0.0"/><arg name="point3_z" value="0.60"/>
        <arg name="point4_x" value="0.0"/><arg name="point4_y" value="0.0"/><arg name="point4_z" value="0.60"/>
    </include>

    <!-- LDOP 与 Diff 分开限频：Diff 继续使用原始点云，LDOP 只处理最新的 5 Hz 点云。 -->
    <node if="$(arg start_ldop)" pkg="topic_tools" type="throttle" name="uav1_ldop_cloud_throttle"
          args="messages $(arg cloud_topic) $(arg ldop_input_rate) /UAV1/ldop/cloud_registered_throttled"/>

    <!-- 启动 UAV1 动态检测，所有输出限定在 UAV1/ldop 命名空间。 -->
    <include if="$(arg start_ldop)" file="$(find ldop)/launch/run_ldop.launch">
        <arg name="vehicle_ns" value="UAV1"/>
        <arg name="rviz" value="false"/>
        <arg name="input_cloud_topic" value="/UAV1/ldop/cloud_registered_throttled"/>
        <arg name="ufomap_resolution" value="0.05"/>
        <arg name="ufomap_inflate_hits_dist" value="0.1"/>
        <arg name="corridor_min_lateral_span" value="0.15"/>
        <arg name="corridor_min_confirm_hits" value="3"/>
        <arg name="corridor_min_cluster_points" value="4"/>
        <arg name="corridor_max_cluster_extent" value="0.8"/>
        <arg name="corridor_oversized_split_enabled" value="false"/>
        <arg name="corridor_split_min_cluster_points" value="3"/>
        <arg name="corridor_max_candidates" value="3"/>
        <arg name="corridor_reject_candidate_count" value="5"/>
        <arg name="corridor_wall_clearance" value="0.10"/>
        <arg name="dynamic_cluster_detector_min_points" value="4"/>
    </include>

    <include if="$(eval arg('detector_backend') == 'fapp' and not arg('fapp_verified_preset'))" file="$(find mot_mapping)/launch/uav1_detection.launch">
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="input_rate" value="$(arg ldop_input_rate)"/>
    </include>

    <include if="$(eval arg('detector_backend') == 'fapp' and arg('fapp_verified_preset'))"
             file="$(find mot_mapping)/launch/uav1_frame_event_verified.launch">
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
    </include>

    <!-- 2026-07-28: UAV1 traj_server是后机PositionCommand唯一发布者，并负责心跳超时安全锁点。 -->
    <node pkg="diff_planner" name="drone_1_traj_server" type="traj_server" output="screen">
        <remap from="/position_cmd" to="$(arg position_cmd_topic)"/>
        <remap from="~planning/trajectory" to="/drone_1_planning/trajectory"/>
        <remap from="/planning/yaw" to="/UAV1/planning/yaw"/>
        <!-- traj_server只订阅规划器心跳；允许单次困难规划最长阻塞180秒。 -->
        <remap from="~heartbeat" to="/drone_1_planning/heartbeat"/>
        <remap from="~safety_hold" to="/UAV1/planning/safety_hold"/>
        <remap from="/planning/traj_started" to="/UAV1/planning/traj_started"/>
        <param name="traj_server/time_forward" value="0.35" type="double"/>
        <param name="traj_server/heartbeat_timeout" value="180.0" type="double"/>
        <param name="traj_server/yaw_dot_max" value="1.57" type="double"/>
        <param name="traj_server/yaw_dot_dot_max" value="6.28" type="double"/>
    </node>

    <!-- Diff 自带 exp.rviz 使用 world；UAV1 FAST-LIO 使用 UAV1/camera_init。 -->
    <node if="$(arg publish_world_to_follower_tf)"
          pkg="tf2_ros" type="static_transform_publisher"
          name="relay_diff_world_to_uav1_camera_init"
          args="0 0 0 0 0 0 world UAV1/camera_init"/>

    <!-- 为 exp.rviz 提供 drone_1 的机体和里程计轨迹。 -->
    <node if="$(arg enable_rviz)"
          pkg="odom_visualization" name="drone_1_odom_visualization"
          type="odom_visualization" output="screen">
        <remap from="~odom" to="$(arg odom_topic)"/>
        <remap from="~cmd" to="$(arg position_cmd_topic)"/>
        <param name="color/a" value="1.0"/>
        <param name="color/r" value="0.0"/>
        <param name="color/g" value="0.35"/>
        <param name="color/b" value="1.0"/>
        <param name="covariance_scale" value="100.0"/>
        <param name="robot_scale" value="0.35"/>
        <param name="frame_id" value="UAV1/camera_init"/>
        <param name="use_cmd_yaw_for_mesh" value="true"/>
        <param name="cmd_yaw_timeout" value="0.8"/>
        <param name="rotate_yaw_deg" value="90.0"/>
        <param name="tf45" value="false"/>
        <param name="drone_id" value="1"/>
    </node>

    <!-- 默认打开 Diff-Planner 自带 RViz；修正配置中 drone_1 的旧话题。 -->
    <node if="$(arg enable_rviz)" name="UAV1_diff_rviz" pkg="rviz" type="rviz"
          args="-d $(find diff_planner)/launch/include/exp.rviz" output="screen">
        <remap from="/move_base_simple/goal" to="$(arg goal_topic)"/>
        <remap from="/drone__diff_planner_node/goal_point"
               to="/drone_1_diff_planner_node/goal_point"/>
        <remap from="/diff_planner_node/global_list"
               to="/drone_1_diff_planner_node/global_list"/>
        <remap from="/diff_planner_node/a_star_list"
               to="/drone_1_diff_planner_node/a_star_list"/>
    </node>
    <!--
      只录动态障碍诊断所需话题，-o 会自动追加时间戳，避免覆盖旧包。
      roslaunch 退出时向该进程发送 SIGINT，保证生成完整 .bag 而非 .bag.active。
    -->
    <node if="$(arg record_dynamic_debug)" pkg="rosbag" type="record"
          name="corridor_dynamic_debug_bag" output="log"
          args="record -o $(arg dynamic_bag_prefix) --buffsize=1024
                $(arg cloud_topic)
                $(arg odom_topic)
                /UAV1/fapp/cloud_registered_throttled
                /UAV1/fapp/dynamic_cloud
                /UAV1/fapp/map_cloud
                /UAV1/fapp/dynamic_object_markers
                /UAV1/fapp/dynamic_track_markers
                /UAV1/fapp/states
                /UAV1/ldop/cloud_registered_throttled
                /UAV1/ldop/static_cloud
                /UAV1/ldop/dynamic_cloud
                /UAV1/ldop/dynamic_objects
                /UAV1/ldop/dynamic_object_predictions
                /UAV1/ldop/dynamic_object_markers
                /UAV1/ldop/dynamic_track_markers
                /UAV1/ldop/dynamic_prediction_markers
                /UAV1/corridor_dynamic_objects
                /UAV1/corridor_dynamic_markers
                /mavros/local_position/odom
                /tf
                /tf_static
                /rosout"/>

</launch>
