<launch><arg name="landing_via_mpc" default="false" />
  <arg name="auto_land_at_cutoff" default="true" />
  <arg name="vehicle_ns" default="UAV0" />
  <arg name="topic_prefix" default="$(eval '/' + arg('vehicle_ns').strip('/'))" />
  <arg name="image_topic" default="$(arg topic_prefix)/down_camera/image_raw" />
  <arg name="camera_info_topic" default="$(arg topic_prefix)/down_camera/camera_info" />
  <arg name="local_pose_topic" default="$(arg topic_prefix)/mavros/local_position/pose" />
  <arg name="mavros_state_topic" default="$(arg topic_prefix)/mavros/state" />
  <arg name="odometry_topic" default="$(arg topic_prefix)/fast_lio/Odom_high_freq" />
  <arg name="trigger_topic" default="$(arg topic_prefix)/need_to_land" />
  <arg name="target_id_topic" default="$(arg topic_prefix)/landing/target_id" />
  <arg name="assigned_id_topic" default="$(arg topic_prefix)/landing/assigned_id" />
  <arg name="excluded_id_topic" default="$(arg topic_prefix)/landing/excluded_id" />
  <arg name="candidates_topic" default="$(arg topic_prefix)/landing/search/candidates" />
  <arg name="setpoint_topic" default="$(arg topic_prefix)/mavros/setpoint_raw/local" />
  <arg name="attitude_setpoint_topic" default="$(arg topic_prefix)/mavros/setpoint_raw/attitude" />
  <arg name="set_mode_service" default="$(arg topic_prefix)/mavros/set_mode" />
  <arg name="enable_setpoint_arbiter" default="true" />
  <arg name="controller_position_input" default="$(arg topic_prefix)/control/position_setpoint" />
  <arg name="controller_attitude_input" default="$(arg topic_prefix)/control/attitude_setpoint" />
  <arg name="landing_setpoint_input" default="$(arg topic_prefix)/landing/setpoint_raw/local" />
  <arg name="enable_landing_search" default="true" />
  <arg name="require_platform_assignment" default="false" />
  <arg name="enable_front_aruco_hint" default="false" />
  <arg name="front_image_topic" default="/camera/color/image_raw" />
  <arg name="front_camera_info_topic" default="/camera/color/camera_info" />
  <arg name="front_depth_topic" default="/camera/aligned_depth_to_color/image_raw" />
  <arg name="front_aruco_hint_topic" default="$(arg topic_prefix)/landing/front_aruco_hint" />
  <arg name="front_aruco_candidates_topic" default="$(arg topic_prefix)/landing/front/candidates" />
  <arg name="mission_status_topic" default="$(arg topic_prefix)/mission/task_status" />
  <arg name="mission_landing_request_topic" default="$(arg topic_prefix)/mission/landing_request" />
  <arg name="early_handoff_on_assigned_marker" default="false" />
  <arg name="early_handoff_authorization_topic" default="/dual_uav_landing/release_uav1" />
  <arg name="landing_marker_world_topic" default="$(arg topic_prefix)/mission/detection/final_aruco" />

  <arg name="enable_aruco_rosbag" default="true" />
  <arg name="aruco_rosbag_prefix" default="$(env HOME)/.ros/aruco_detection_$(arg vehicle_ns)" />

  <arg name="landing_search_config" default="$(find precision_landing)/config/landing_search.yaml" />
  <arg name="camera_extrinsic_config" default="" />


  <node pkg="uav1_inplace_landing_test" type="uav1_test_precision_landing_node" name="precision_landing_node" ns="$(arg vehicle_ns)" output="screen">
    <rosparam command="load" file="$(find uav1_inplace_landing_test)/config/precision_landing.yaml" />
    <rosparam if="$(eval arg('camera_extrinsic_config') != '')" command="load" file="$(arg camera_extrinsic_config)" />

    <rosparam command="load" file="$(find uav1_inplace_landing_test)/config/center_offset_uav1.yaml"/>
    <param name="auto_land_at_cutoff" value="$(arg auto_land_at_cutoff)" />

    <param name="topics/image" value="$(arg image_topic)" />
    <param name="topics/camera_info" value="$(arg camera_info_topic)" />
    <param name="topics/local_pose" value="$(arg local_pose_topic)" />
    <param name="topics/mavros_state" value="$(arg mavros_state_topic)" />
    <param name="topics/trigger" value="$(arg trigger_topic)" />
    <param name="topics/target_id" value="$(arg target_id_topic)" />
    <param name="topics/setpoint" value="$(arg landing_setpoint_input)" />
    <param name="topics/set_mode_service" value="$(arg set_mode_service)" />
    <param name="topics/landing_state" value="$(arg topic_prefix)/landing/state" />
    <param name="topics/operator_status" value="$(arg topic_prefix)/landing/status" />
    <param name="topics/locked_id" value="$(arg topic_prefix)/landing/locked_id" />
    <param name="topics/target_pose" value="$(arg topic_prefix)/landing/target_pose" />
    <param name="topics/error_xy" value="$(arg topic_prefix)/landing/error_xy" />
    <param name="topics/debug_image" value="$(arg topic_prefix)/landing/debug_image" />
    <param name="topics/success" value="$(arg topic_prefix)/landing/success" />
  </node>


  </launch>
