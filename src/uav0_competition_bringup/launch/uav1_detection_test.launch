<launch>
  <arg name="open_rviz" default="true" />
  <arg name="enable_thermal" default="true" />
  <arg name="record_bag" default="true" />
  <arg name="record_root" default="$(env HOME)/match_ws/target_reports/uav1_detection_test" />
  <arg name="mission_id" default="" />

  <!-- D435 使用已有压缩话题；保留原时间戳，深度为无损 compressedDepth。
       原始热图、候选状态、同帧映射证据及 TF 用于区分识别、定位和上报问题。 -->
  <node if="$(arg record_bag)" pkg="uav0_competition_bringup"
        type="record_detection_test.sh" name="uav1_detection_test_recorder" output="screen"
        args="'$(arg record_root)/$(arg mission_id)/bags/detection'
          /UAV1/camera/color/image_raw/compressed
          /UAV1/camera/aligned_depth_to_color/image_raw/compressedDepth
          /UAV1/camera/color/camera_info
          /UAV1/camera/aligned_depth_to_color/camera_info
          /UAV1/vision/qr_candidate_detected
          /UAV1/vision/qr_candidate_pose_camera
          /UAV1/vision/qr_detected
          /UAV1/color_tag_detector/candidate_text
          /UAV1/color_tag_detector/candidate_point_camera
          /UAV1/color_tag_detector/result_text
          /UAV1/thermal/image_raw
          /UAV1/thermal/debug_image
          /UAV1/thermal/target_candidate_status
          /UAV1/thermal/report_candidate
          /UAV1/thermal/d435_evidence_image
          /UAV1/target_reporting/observation
          /UAV1/fast_lio/Odometry
          /UAV1/fast_lio/Odom_high_freq
          /tf /tf_static /rosout /rosout_agg" />

  <!-- 使用实机同一套雷达与定位配置，FAST-LIO 自行发布 world -> body TF。 -->
  <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch">
    <arg name="vehicle_ns" value="UAV1" />
  </include>
  <include file="$(find fast_lio)/launch/mapping_mid360.launch">
    <arg name="vehicle_ns" value="UAV1" />
    <arg name="rviz" value="false" />
    <arg name="performance_logging" value="false" />
    <arg name="publish_odometry" value="true" />
  </include>

  <!-- 复用多机检测入口：唯一检测行为差异是立即开始识别，无入口等待。 -->
  <include file="$(find uav0_competition_bringup)/launch/uav1_detection_stack.launch">
    <arg name="detection_activation_config"
         value="$(find target_reporting)/config/uav1_detection_test_activation.yaml" />
    <arg name="target_reporting_record_root" value="$(arg record_root)" />
    <arg name="target_reporting_mission_id" value="$(arg mission_id)" />
    <arg name="enable_thermal" value="$(arg enable_thermal)" />
  </include>
  <!-- 直接复用多机后机的 RViz、里程计限频和轨迹/模型显示，不启动跟随控制。 -->
  <include if="$(arg open_rviz)"
           file="$(find exploration_control)/launch/uav1_relay_visualization.launch" />
</launch>
