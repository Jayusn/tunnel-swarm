<?xml version="1.0"?>
<package format="2">
  <name>payload_mpc_controller</name>
  <version>0.0.0</version>
  <description>Model Predictive Control for Quadrotors with Payload</description>

  <maintainer email="hlied@connect.ust.hk">Haojia Li</maintainer>

  <license>GNU GPL</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>traj_utils</depend>
  <depend>roscpp</depend>
  <depend>rosbag</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <depend>rospy</depend>
  <depend>rosgraph_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>uav_utils</depend>
  <depend>mavros</depend>

  <export>
  </export>
  <test_depend>rostest</test_depend>
</package>
